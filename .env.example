# ---- ScreenSaver ----
# Copy this file to .env and fill in real values. Never commit .env.

# Admin account (the only user who can capture / issue OTPs / stop the server).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Reserved ngrok domain. The ngrok CLI must be authenticated beforehand;
# no ngrok token is stored here. Leave empty to serve on HOST directly.
NGROK_DOMAIN=changeme.ngrok-free.app

# Flask session signing key (any long random string).
# Generate using: python -c "import os; print(os.urandom(32).hex())"
SECRET_KEY=replace-with-a-long-random-string

# Web UI host. With NGROK_DOMAIN set the app binds to localhost only and
# is reachable exclusively through the tunnel.
HOST=127.0.0.1

# Web UI port.
PORT=5000